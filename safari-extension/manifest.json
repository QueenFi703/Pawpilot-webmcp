{
  "manifest_version": 3,
  "name": "PawPilot WebMCP Bridge",
  "version": "0.1.0",
  "description": "Safari Web Extension developer console and compatibility bridge for inspecting and testing WebMCP pages.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "*://pawpilot.ai/*",
    "*://*.pawpilot.ai/*",
    "*://*.netlify.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PawPilot WebMCP",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pawpilot.ai/*",
        "*://*.pawpilot.ai/*",
        "*://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "css": ["console.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
